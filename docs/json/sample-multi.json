{
  "schema": 1,
  "herdeck": "0.4.0",
  "bin": "/usr/local/bin/herdeck",
  "deck": "~/.config/herdeck/tabs.toml",
  "demo": false,
  "tabs": [
    {
      "index": 1,
      "name": "Builds",
      "type": "exec",
      "interval": 10,
      "state": "ok",
      "status": "partial: 1 runner offline",
      "message": null,
      "table": {
        "header": "main · 3 pipelines",
        "columns": ["JOB", "STATE", "PROGRESS", "QUEUE 1h", "AGE"],
        "rows": [
          { "section": "Running" },
          { "cells": [
              { "kind": "text", "text": "test-linux", "tone": null },
              { "kind": "text", "text": "running", "tone": "accent" },
              { "kind": "bar", "value": 7, "max": 12, "text": "7/12", "tone": "ok", "width": 10 },
              { "kind": "spark", "values": [1, 3, 2, 5, 4, 6, 3], "max": 8, "tone": "accent", "width": 10 },
              { "kind": "text", "text": "4m", "tone": null } ],
            "detail": "step 7 of 12: integration tests (shard 2)", "key": "job-118" },
          { "cells": [
              { "kind": "text", "text": "test-macos", "tone": null },
              { "kind": "text", "text": "queued", "tone": "dim" },
              { "kind": "bar", "value": 0, "max": 12, "text": "0/12", "tone": "ok", "width": 10 },
              { "kind": "spark", "values": [0.5, 0.25, 1.75], "max": null, "tone": "accent", "width": 10 },
              { "kind": "text", "text": "-", "tone": "dim" } ],
            "key": "job-119" },
          { "section": "Finished" },
          { "cells": [
              { "kind": "text", "text": "lint", "tone": null },
              { "kind": "text", "text": "passed", "tone": "ok" },
              { "kind": "bar", "value": 12, "max": 12, "text": "12/12", "tone": "bad", "width": 10 },
              { "kind": "spark", "values": [], "max": null, "tone": "accent", "width": 10 },
              { "kind": "text", "text": "22m", "tone": null } ] },
          { "cells": [
              { "kind": "text", "text": "deploy-staging-with-a-rather-long-job-name-that-must-truncate", "tone": null },
              { "kind": "text", "text": "failed", "tone": "bad" },
              { "kind": "bar", "value": 9, "max": 12, "text": "9/12", "tone": "warn", "width": 10 },
              { "kind": "spark", "values": [2, 2, 2, 2, 2, 2, 2, 2, 2, 2], "max": null, "tone": "accent", "width": 10 },
              { "kind": "text", "text": "1h", "tone": null } ],
            "detail": "exit 1: health check timed out after 30s", "key": "job-115" }
        ]
      }
    },
    {
      "index": 2,
      "name": "Log",
      "type": "command",
      "interval": 10,
      "state": "ok",
      "status": "OK",
      "message": null,
      "table": {
        "header": "$ tail -n 4 /var/log/app.log",
        "columns": ["output"],
        "rows": [
          { "cells": [ { "kind": "text", "text": "12:00:01 INFO  started worker pool (4)", "tone": null } ] },
          { "cells": [ { "kind": "text", "text": "12:00:07 WARN  cache miss rate 41%", "tone": "warn" } ] },
          { "cells": [ { "kind": "text", "text": "12:00:09 ERROR upstream returned 502", "tone": "bad" } ] },
          { "cells": [ { "kind": "text", "text": "", "tone": null } ] }
        ]
      }
    },
    {
      "index": 3,
      "name": "Metrics",
      "type": "prometheus",
      "interval": 15,
      "state": "error",
      "status": "error: http://prometheus.example.com:9090: connection refused",
      "message": "http://prometheus.example.com:9090: connection refused",
      "table": null
    },
    {
      "index": 4,
      "name": "Slow script",
      "type": "exec",
      "interval": 60,
      "state": "timeout",
      "status": "timeout",
      "message": "no answer within 15s",
      "table": null
    },
    {
      "index": 5,
      "name": "Weather",
      "type": "json",
      "interval": 600,
      "state": "not_set_up",
      "status": "not set up",
      "message": "Not set up yet. Add this to the tab in ~/.config/herdeck/tabs.toml, then reopen herdeck:",
      "table": {
        "header": "Not set up yet. Add this to the tab in ~/.config/herdeck/tabs.toml, then reopen herdeck:",
        "columns": ["TO DO"],
        "rows": [
          { "cells": [ { "kind": "text", "text": "url = \"https://...\"   # an HTTP endpoint returning JSON", "tone": null } ] }
        ]
      }
    },
    {
      "index": 6,
      "name": "Empty",
      "type": "command",
      "interval": 10,
      "state": "ok",
      "status": "OK",
      "message": null,
      "table": { "header": null, "columns": ["output"], "rows": [] }
    }
  ]
}
